{
  "name": "cosmoids",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter @cosmoids/web dev",
    "dev:api": "pnpm --filter @cosmoids/api dev",
    "db:up": "docker compose --env-file apps/api/.env -f compose.local.yaml up -d --wait",
    "db:stop": "docker compose --env-file apps/api/.env -f compose.local.yaml stop",
    "auth:migrate:local": "pnpm --filter @cosmoids/api auth:migrate:local",
    "build": "pnpm --filter @cosmoids/web build",
    "build:api": "pnpm --filter @cosmoids/api build",
    "build:check": "pnpm --filter @cosmoids/web build:check",
    "typecheck": "pnpm --filter @cosmoids/web typecheck",
    "typecheck:api": "pnpm --filter @cosmoids/api typecheck",
    "test:api": "pnpm --filter @cosmoids/api test",
    "verify:quick": "pnpm --filter @cosmoids/web verify:quick",
    "start": "pnpm --filter @cosmoids/web start",
    "start:api": "pnpm --filter @cosmoids/api start",
    "lint": "pnpm --filter @cosmoids/web lint",
    "test": "pnpm --filter @cosmoids/web test",
    "test:unit": "pnpm --filter @cosmoids/web test:unit",
    "test:ui": "pnpm --filter @cosmoids/web test:ui",
    "test:coverage": "pnpm --filter @cosmoids/web test:coverage",
    "test:e2e": "pnpm --filter @cosmoids/web test:e2e",
    "test:e2e:ui": "pnpm --filter @cosmoids/web test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @cosmoids/web test:e2e:headed",
    "validate:dialogs": "pnpm --filter @cosmoids/web validate:dialogs",
    "test:creatures": "pnpm --filter @cosmoids/web test:creatures",
    "test:attacks": "pnpm --filter @cosmoids/web test:attacks",
    "test:progression": "pnpm --filter @cosmoids/web test:progression",
    "test:content": "pnpm --filter @cosmoids/web test:content",
    "assets:optimize": "pnpm --filter @cosmoids/web assets:optimize",
    "assets:optimize:journals": "pnpm --filter @cosmoids/web assets:optimize:journals",
    "assets:optimize:story-backgrounds": "pnpm --filter @cosmoids/web assets:optimize:story-backgrounds",
    "assets:optimize:story-portraits": "pnpm --filter @cosmoids/web assets:optimize:story-portraits",
    "assets:optimize:level-backgrounds": "pnpm --filter @cosmoids/web assets:optimize:level-backgrounds",
    "assets:optimize:starter-art": "pnpm --filter @cosmoids/web assets:optimize:starter-art",
    "assets:optimize:battle-characters": "pnpm --filter @cosmoids/web assets:optimize:battle-characters",
    "assets:optimize:creature-icons": "pnpm --filter @cosmoids/web assets:optimize:creature-icons",
    "assets:optimize:battle-cosmoids": "pnpm --filter @cosmoids/web assets:optimize:battle-cosmoids",
    "assets:optimize:battle-support": "pnpm --filter @cosmoids/web assets:optimize:battle-support",
    "assets:optimize:title-art": "pnpm --filter @cosmoids/web assets:optimize:title-art",
    "assets:optimize:root-creature-art": "pnpm --filter @cosmoids/web assets:optimize:root-creature-art",
    "prepare": "husky",
    "storybook": "pnpm --filter @cosmoids/web storybook",
    "build-storybook": "pnpm --filter @cosmoids/web build-storybook"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
