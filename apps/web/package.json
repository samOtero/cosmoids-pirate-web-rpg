{
  "name": "@cosmoids/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "pnpm lint && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "verify:quick": "pnpm typecheck && pnpm validate:creature-manifests && pnpm test:unit",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:unit": "vitest run --project=unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "validate:dialogs": "vitest run src/__tests__/integration/dialogConfig.test.ts --project=unit",
    "validate:creature-manifests": "node scripts/creatures/validate-manifests.mjs",
    "test:creatures": "vitest run src/__tests__/integration/creatureManifest.test.ts --project=unit",
    "assets:optimize": "node scripts/assets/optimize-art-assets.mjs",
    "assets:optimize:journals": "node scripts/assets/optimize-art-assets.mjs journal",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.4",
    "pixi.js": "^8.16.0",
    "posthog-js": "^1.427.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "4.0.14",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "4.0.14",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-storybook": "^10.4.0",
    "jsdom": "^27.2.0",
    "playwright": "1.58.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.4",
    "storybook": "^10.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vitest": "^4.0.14"
  }
}
